scrollThumb.BackgroundColor3 = Color3.new(0.5, 0.5, 0.5)
scrollThumb.BorderSizePixel = 1
scrollThumb.BorderColor3 = Color3.new(0.7, 0.7, 0.7)
scrollThumb.Parent = modePanel

local isDragging = false
local startTouchY = 0
local startScrollRatio = 0
scrollThumb.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isDragging = true
        startTouchY = input.Position.Y
        local containerHeight = scrollContainer.AbsoluteSize.Y
        local contentHeight = modeContent.AbsoluteSize.Y
        local maxOffset = math.max(0, contentHeight - containerHeight)
        startScrollRatio = (-modeContent.Position.Y.Offset) / maxOffset
        startScrollRatio = math.clamp(startScrollRatio, 0, 1)
        
        local connection
        connection = input:GetPropertyChangedSignal("Position"):Connect(function()
            if not isDragging then
                connection:Disconnect()
                return
            end
            local deltaY = input.Position.Y - startTouchY
            local containerHeight = scrollContainer.AbsoluteSize.Y
            local contentHeight = modeContent.AbsoluteSize.Y
            local maxOffset = math.max(0, contentHeight - containerHeight)
            if maxOffset <= 0 then
                connection:Disconnect()
                return
            end
            
            local newScrollRatio = startScrollRatio + (deltaY / containerHeight)
            newScrollRatio = math.clamp(newScrollRatio, 0, 1)
            local newContentY = -newScrollRatio * maxOffset
            modeContent.Position = UDim2.new(0, 0, 0, newContentY)
            scrollThumb.Position = UDim2.new(1, -15, 0, newScrollRatio * (containerHeight - scrollThumb.AbsoluteSize.Y) + 10)
        end)
    end
end)

game:GetService("UserInputService").InputEnded:Connect(function(input)
    if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and isDragging then
        isDragging = false
    end
end)

local function initScrollThumbPos()
    local containerHeight = scrollContainer.AbsoluteSize.Y
    local contentHeight = modeContent.AbsoluteSize.Y
    local maxOffset = math.max(0, contentHeight - containerHeight)
    scrollThumb.Visible = maxOffset > 0
    if maxOffset > 0 then
        scrollThumb.Position = UDim2.new(1, -15, 0, 10)
    end
end
